            "text": "import { auth } from \"/lib/firebase.ts\";\nimport { normalizeEmail } from \"/lib/invite-state.ts\";\nconst pollIntervalMs = 3e4;\nasync function getAuthToken() {\n\tconst user = auth.currentUser;\n\tif (!user) {\n\t\tthrow new Error(\"Not authenticated\");\n\t}\n\treturn user.getIdToken();\n}\nasync function requestJson(input, init) {\n\tconst token = await getAuthToken();\n\tconst response = await fetch(input, {\n\t\tcache: \"no-store\",\n\t\t...init,\n\t\theaders: {\n\t\t\t\"content-type\": \"application/json\",\n\t\t\tAuthorization: `Bearer ${token}`,\n\t\t\t...init?.headers ?? {}\n\t\t}\n\t});\n\tconst payload = await response.json();\n\tif (!response.ok) {\n\t\tthrow new Error(payload.error ?? `Request failed with ${response.status}`);\n\t}\n\treturn payload;\n}\nfunction watchList(urlFactory, key, onChange, options) {\n\tlet cancelled = false;\n\tasync function refresh() {\n\t\ttry {\n\t\t\tconst payload = await requestJson(urlFactory());\n\t\t\tif (!cancelled) onChange(payload[key] ?? []);\n\t\t} catch (cause) {\n\t\t\tif (!cancelled) console.error(cause);\n\t\t}\n\t}\n\tvoid refresh();\n\tlet interval;\n\tif (!options?.disablePolling) {\n\t\tinterval = window.setInterval(refresh, pollIntervalMs);\n\t}\n\treturn () => {\n\t\tcancelled = true;\n\t\tif (interval !== undefined) window.clearInterval(interval);\n\t};\n}\nexport const teamStore = {\n\twatchOwnedTeams(userId, onChange, options) {\n\t\treturn watchList(() => `/api/teams?userId=${encodeURIComponent(userId)}`, \"teams\", onChange, options);\n\t},\n\twatchInvites(email, onChange, options) {\n\t\treturn watchList(() => `/api/invites?email=${encodeURIComponent(normalizeEmail(email))}`, \"invites\", onChange, options);\n\t},\n\twatchOutgoingInvites(teamId, onChange, options) {\n\t\treturn watchList(() => `/api/invites?teamId=${encodeURIComponent(teamId)}`, \"outgoingInvites\", onChange, options);\n\t},\n\tasync getUserProfile() {\n\t\tconst res = await requestJson(\"/api/users\");\n\t